#cloud-config
hostname: {{ item.name }}
manage_etc_hosts: true
enable_ssh: true
ssh_pwauth: true

# Locale and timezone
locale: {{ locale }}
timezone: {{ timezone }}

# NTP configuration
ntp:
  enabled: true
  servers:
{% for server in ntp_servers %}
    - {{ server }}
{% endfor %}

# NOTE: No package_update/package_upgrade here. Ansible handles packages
# after /var migration to avoid corrupting dpkg state.

users:
  - name: {{ username }}
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: {{ 'true' if password is not defined else 'false' }}
{% if password is defined %}
    plain_text_passwd: {{ password }}
{% endif %}
    ssh_authorized_keys:
      - {{ ssh_public_key }}
    sudo: ALL=(ALL) NOPASSWD:ALL

write_files:
  - path: /etc/ssh/sshd_config.d/99-custom.conf
    content: |
      Port {{ ssh_port }}
    owner: root:root
    permissions: '0644'

runcmd:
  - systemctl restart sshd
{% if item.os == 'raspios' %}
  # Migrate /var to attached HDD
  - |
    set -e
    # Wipe, partition, and format
    wipefs -a /dev/sda
    parted -s /dev/sda mklabel gpt mkpart primary ext4 0% 100%
    sleep 2
    mkfs.ext4 -F /dev/sda1
    # Mount and copy
    mkdir -p /tmp/var-hdd
    mount /dev/sda1 /tmp/var-hdd
    rsync -aAX /var/ /tmp/var-hdd/
    umount /tmp/var-hdd
    # Add to fstab with UUID
    UUID=$(blkid -s UUID -o value /dev/sda1)
    echo "UUID=$UUID /var ext4 defaults,noatime 0 2" >> /etc/fstab
    echo "/var migration complete. Rebooting..."
    reboot
{% endif %}
