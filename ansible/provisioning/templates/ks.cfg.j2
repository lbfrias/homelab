#version=RHEL10
# Rocky Linux 10 Kickstart — {{ item.name }}
# Generated by homelab provisioning playbook

#---------- Installation Mode ----------
text

#---------- Installation Source ----------
# Use network install to avoid USB locking issues
url --url="https://download.rockylinux.org/pub/rocky/10/BaseOS/x86_64/os/"

#---------- Locale & Keyboard ----------
lang {{ locale }}
keyboard --xlayouts='{{ keyboard_layout }}'
timezone {{ timezone }} --utc

#---------- NTP Time Sources (RHEL 10+ syntax) ----------
{% for server in ntp_servers %}
timesource --ntp-server={{ server }}
{% endfor %}

#---------- Network ----------
network --bootproto=dhcp --device=link --activate --onboot=yes
network --hostname={{ item.name }}

#---------- Root Password (locked/disabled) ----------
rootpw --lock --iscrypted locked

#---------- Create User with SSH Key ----------
user --name={{ username }} --groups=wheel --gecos="{{ username }}"
sshkey --username={{ username }} "{{ ssh_public_key }}"

#---------- Disk Configuration ----------
# Install to first SATA device (internal SSD)
ignoredisk --only-use=sda
zerombr
clearpart --all --initlabel --drives=sda

#---------- Partitioning: Standard layout, ext4, small swap ----------
# UEFI boot partition
part /boot/efi --fstype=efi --size=600 --ondisk=sda

# Boot partition
part /boot --fstype=ext4 --size=1024 --ondisk=sda

# LVM Physical Volume (rest of disk)
part pv.01 --fstype=lvmpv --size=1 --grow --ondisk=sda

# Volume Group
volgroup rl pv.01 --pesize=4096

# Logical Volumes — optimized for k3s workloads on 120GB SSD
# /var gets most space for container images, etcd, logs
logvol / --fstype=ext4 --name=root --vgname=rl --size=30000
logvol /var --fstype=ext4 --name=var --vgname=rl --size=1 --grow
logvol /home --fstype=ext4 --name=home --vgname=rl --size=5000
logvol swap --fstype=swap --name=swap --vgname=rl --size=4096

#---------- Bootloader ----------
bootloader --location=mbr --boot-drive=sda --append="crashkernel=1G-4G:192M,4G-64G:256M,64G-:512M"

#---------- SELinux ----------
selinux --enforcing

#---------- Firewall ----------
# Disabled: K3s manages iptables directly (conflicts with firewalld)
firewall --disabled

#---------- Services ----------
services --enabled=sshd,NetworkManager,avahi-daemon

#---------- Skip GUI ----------
skipx
firstboot --disabled

#---------- Package Selection ----------
%packages
@^minimal-environment
openssh-server
openssh-clients
sudo
vim-minimal
rsync
avahi
nss-mdns
-plymouth
%end

#---------- Post-installation Script ----------
%post --log=/root/ks-post.log

# Configure passwordless sudo for wheel group
echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd
chmod 440 /etc/sudoers.d/wheel-nopasswd

# Custom SSH port
cat > /etc/ssh/sshd_config.d/99-custom.conf << 'EOF'
Port {{ ssh_port }}
PermitRootLogin no
PasswordAuthentication no
EOF

# Ensure SSH key permissions
if [ -d /home/{{ username }}/.ssh ]; then
    chmod 700 /home/{{ username }}/.ssh
    chmod 600 /home/{{ username }}/.ssh/authorized_keys
    chown -R {{ username }}:{{ username }} /home/{{ username }}/.ssh
fi

# Note: Firewall disabled for K3s compatibility — SSH port open by default

#---------- NAS Drive Mount (4TB USB HDD as RAID1 degraded) ----------
# Create mount point for existing RAID array
mkdir -p /mnt/data

# Add fstab entry for md0 only if not already present (idempotent)
if ! grep -q '/dev/md0' /etc/fstab; then
  cat >> /etc/fstab << 'FSTAB'
# NAS storage - 4TB USB HDD (RAID1 degraded)
/dev/md0 /mnt/data xfs defaults,noatime,nofail 0 2
FSTAB
fi

%end

#---------- Reboot after installation ----------
reboot --eject
