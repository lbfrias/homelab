{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)manifests/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)manifests/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)manifests/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Leaf-level grouping for apps (each app directory = one PR)",
      "matchFileNames": [
        "manifests/apps/**"
      ],
      "groupName": "{{parentDir}}"
    },
    {
      "description": "Schedule infrastructure updates for Monday morning",
      "matchFileNames": [
        "manifests/infrastructure/**"
      ],
      "schedule": ["before 9am on monday"]
    },
    {
      "description": "Automerge patch updates for Helm charts",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "ignorePaths": [
    "**/ansible/**",
    "**/docs/**"
  ]
}
